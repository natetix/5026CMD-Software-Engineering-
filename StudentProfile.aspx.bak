<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="StudentProfile.aspx.cs" Inherits="StudentManagementSystem.StudentProfile" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>My Profile</title>
    <style>
        body { font-family: Arial; margin: 0; background-color: #f5f5f5; }
        .menu { background-color: darkblue; padding: 15px; }
        .menu a { color: white; text-decoration: none; margin-right: 25px; font-weight: bold; font-size: 16px; }
        .content { padding: 30px; }
        h2 { color: darkblue; }
        h3 { color: #555; margin-top: 30px; }
        .profile-box {
            background-color: white; padding: 25px; border-radius: 10px;
            box-shadow: 0px 0px 10px lightgray; max-width: 600px; margin-bottom: 30px;
        }
        .field { margin-bottom: 15px; }
        .field label { font-weight: bold; display: inline-block; width: 160px; color: darkblue; }
        .field span { color: #333; }
        .stat-cards { margin-bottom: 30px; }
        .card {
            width: 180px; background-color: white; padding: 20px;
            border-radius: 10px; display: inline-block; margin-right: 20px;
            margin-bottom: 20px; box-shadow: 0px 0px 10px lightgray; text-align: center;
        }
        .card h4 { color: darkblue; margin-bottom: 10px; font-size: 14px; }
        .card .num { font-size: 26px; font-weight: bold; color: #333; }
        .gpa-box {
            background-color: white; padding: 20px; border-radius: 10px;
            box-shadow: 0px 0px 10px lightgray; display: inline-block;
            margin-top: 10px;
        }
    </style>
</head>
<body>
<form id="form1" runat="server">

    <div class="menu">
        <a href="StudentDashboard.aspx">Dashboard</a>
        <a href="CourseEnrollment.aspx">Course Enrollment</a>
        <a href="ViewEnrolledCourses.aspx">View Enrolled Courses</a>
        <a href="StudentViewMarks.aspx">My Marks</a>
        <a href="StudentViewAttendance.aspx">My Attendance</a>
        <a href="DropCourse.aspx">Drop Course</a>
        <a href="StudentAnnouncements.aspx">Announcements</a>
        <a href="StudentProfile.aspx">My Profile</a>
        <asp:Button ID="btnLogout" runat="server" Text="Logout" OnClick="btnLogout_Click" />
    </div>

    <div class="content">
        <h2>My Profile</h2>

        <!-- PERSONAL INFO -->
        <div class="profile-box">
            <div class="field">
                <label>Student ID:</label>
                <span><asp:Label ID="lblStudentID" runat="server" /></span>
            </div>
            <div class="field">
                <label>Full Name:</label>
                <span><asp:Label ID="lblName" runat="server" /></span>
            </div>
            <div class="field">
                <label>Email:</label>
                <span><asp:Label ID="lblEmail" runat="server" /></span>
            </div>
            <div class="field">
                <label>Phone:</label>
                <span><asp:Label ID="lblPhone" runat="server" /></span>
            </div>
        </div>

        <!-- ACADEMIC STATS -->
        <h3>Academic Summary</h3>
        <div class="stat-cards">
            <div class="card">
                <h4>Total Enrollments</h4>
                <div class="num"><asp:Label ID="lblTotal" runat="server" /></div>
            </div>
            <div class="card">
                <h4>Approved</h4>
                <div class="num"><asp:Label ID="lblApproved" runat="server" /></div>
            </div>
            <div class="card">
                <h4>Pending</h4>
                <div class="num"><asp:Label ID="lblPending" runat="server" /></div>
            </div>
        </div>

        <!-- GPA -->
        <div class="gpa-box">
            <span style="font-size:18px; font-weight:bold; color:darkblue;">Cumulative GPA: </span>
            <asp:Label ID="lblGPA" runat="server" Font-Bold="True" Font-Size="20px" ForeColor="DarkBlue" />
        </div>
    </div>

</form>
</body>
</html>
